#!/usr/bin/with-contenv bash
# Install development tools for Claude Code / Ansible workflow.
# Runs at container startup via LSIO custom-cont-init.d.
# Cached via hash marker — subsequent restarts skip if script unchanged.

set -e

MARKER="/config/.packages-installed"
SCRIPT_HASH=$(md5sum "$0" | cut -d' ' -f1)

# Check hash AND verify packages exist (apt lives on overlay, marker on persistent storage)
if [ -f "$MARKER" ] && [ "$(cat "$MARKER")" = "$SCRIPT_HASH" ] && command -v python3 >/dev/null 2>&1 && command -v g++ >/dev/null 2>&1; then
  echo "[custom-init] Packages already installed, skipping"
  exit 0
fi

echo "[custom-init] Installing development packages..."

apt-get update -qq

# Node.js 20 LTS via NodeSource — install BEFORE other packages so its
# nodejs package is authoritative and apt won't pull Ubuntu's conflicting npm.
NODE_MAJOR=20
curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -
apt-get install -y --no-install-recommends nodejs

apt-get install -y --no-install-recommends \
  ansible-core \
  python3 \
  python3-pip \
  python3-venv \
  python3-requests \
  python3-pymysql \
  shellcheck \
  yamllint \
  rsync \
  unzip \
  zip \
  gh \
  make \
  g++ \
  wget \
  ca-certificates \
  curl \
  gnupg

# yq — YAML processor (single static binary)
YQ_VERSION="v4.44.6"
ARCH=$(dpkg --print-architecture)
wget -qO /usr/local/bin/yq \
  "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${ARCH}"
chmod +x /usr/local/bin/yq

# pnpm — fast, strict package manager for Node.js projects
npm install -g pnpm

# Clean up apt cache
apt-get clean
rm -rf /var/lib/apt/lists/*

# Ansible Galaxy collections (includes ansible.posix for syntax checks)
ansible-galaxy collection install -r /workspace/homelab-ops/requirements.yaml --force

# Ensure Ansible tmp dir exists and is owned by abc (LSIO container user)
mkdir -p /config/.ansible/tmp
chown -R abc:abc /config/.ansible

echo "$SCRIPT_HASH" > "$MARKER"
echo "[custom-init] Development packages installed successfully"
