{%- set _stack_name = _current_stack -%}
{%- set _stack_def = stack_definitions[_stack_name] -%}
{%- set _default_globals = ['mem_limit', 'restart', 'tz', 'puid', 'pgid', 'umask', 'appsdir'] -%}
{%- set _global_map = {
  'mem_limit': {'env_var': 'MEM_LIMIT', 'value': docker_mem_limit},
  'restart':   {'env_var': 'RESTART',   'value': docker_restart},
  'tz':        {'env_var': 'TZ',        'value': docker_tz},
  'puid':      {'env_var': 'PUID',      'value': docker_puid},
  'pgid':      {'env_var': 'PGID',      'value': docker_pgid},
  'umask':     {'env_var': 'UMASK',     'value': docker_umask},
  'appsdir':   {'env_var': 'APPSDIR',   'value': docker_appsdir},
} -%}
{%- set _services = {} -%}
{%- for name, def in container_definitions.items() if def.stack | default('') == _stack_name -%}
{%-   set _ = _services.update({name: def}) -%}
{%- endfor -%}
{%- set _ns = namespace(seen_keys=[], seen_img=[]) %}
# Rendered by deploy_stacks.yaml — do not edit manually
# Stack: {{ _stack_name }} | Host: {{ inventory_hostname }}
{% if _stack_def.globals | default(_default_globals) | length > 0 %}
## Global
{% for g in _stack_def.globals | default(_default_globals) -%}
{{ _global_map[g].env_var }}={{ _global_map[g].value }}
{% endfor %}
{%- endif -%}
## Container Images
{% for name, def in _services.items() -%}
{% set _img_prefix = def.compose.image_var | default(name | upper | replace('-', '_')) -%}
{% if _img_prefix not in _ns.seen_img -%}
{{ _img_prefix }}_IMAGE={{ def.image }}
{{ _img_prefix }}_TAG={{ def.tag }}
{% set _ns.seen_img = _ns.seen_img + [_img_prefix] -%}
{% endif -%}
{% endfor %}
{%- for name, def in _services.items() if def.env is defined -%}
## {{ name | replace('_', ' ') | title }}
{% for k, v in def.env.items() -%}
{% if k not in _ns.seen_keys -%}
{{ k }}={{ v }}
{% set _ns.seen_keys = _ns.seen_keys + [k] -%}
{% endif -%}
{% endfor %}
{% endfor -%}
{% if _stack_def.env_extra is defined -%}
## Stack Extra
{{ _stack_def.env_extra }}
{% endif -%}
