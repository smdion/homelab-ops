{#- Auto-generated CrowdSec remediation profiles.
    Source: crowdsec_definitions.yaml (crowdsec.profile) + deploy_crowdsec_configs.yaml.
    Do not edit manually — changes are overwritten on next deploy. -#}
name: default_ip_remediation
filters:
 - Alert.Remediation == true && Alert.GetScope() == "Ip"
decisions:
 - type: ban
   duration: {{ crowdsec.profile.ban_duration }}
duration_expr: {{ crowdsec.profile.duration_expr }}
notifications:
{% for n in crowdsec.profile.notifications %}
  - {{ n }}
{% endfor %}
on_success: break
