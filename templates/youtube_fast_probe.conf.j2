# yt-dlp config for youtube_fast_check.py's channel enumeration + format probes.
# Rendered by deploy_youtube_fast_check.yaml from the SAME vars the real download
# reads (vars/configs/download_base.yaml + download_default.yaml +
# download_on_demand.yaml) so this can never drift from those rules — no filter
# here is reimplemented in Python; yt-dlp applies all of them natively.
#
# playlist-end/dateafter come from download_default.yaml: that profile is what
# used to govern channel-scanning scope, and this script replaces that role for
# YouTube, so its "how far back to look" rules are what apply here. Everything
# else (cookies, extractor-args, quality sort, reject-title, live-filter) comes
# from download_on_demand.yaml (with download_base.yaml underneath), since
# that's the profile fast-path dispatches actually route through.
#
# Deliberately excludes anything download-time-specific (--batch-file, -P paths,
# -o, --download-archive, --print-to-file, retries, post-processing) — those
# either don't apply to enumeration/--skip-download probes or would actively
# misbehave (e.g. --batch-file would pull in every channel_list URL alongside
# the one being probed).

# Extractor configuration — affects which formats/resolutions are exposed
--extractor-args "{{ ytdlp_extractor_args }}"

# Cookies — required for YouTube bot-check bypass
{% if ytdlp_cookies | default('') | length > 0 %}
--cookies "{{ ytdlp_cookies }}"
{% endif %}

# Quality sort — harmless for a format listing, kept for consistency
-S {{ ytdlp_quality }}

# Reject-title — a video excluded here will also be excluded from the real
# download, so probing with the same filter avoids dispatching it pointlessly
--reject-title "{{ ytdlp_reject_title }}"

{% if ytdlp_filter_live | default(true) %}
--match-filter !is_live
{% endif %}

# How far back / how many items channel enumeration considers — same scope
# download_default used to apply when it did this job.
--playlist-end {{ ytdlp_playlist_end }}
{% if ytdlp_dateafter | default('') | length > 0 %}
--dateafter {{ ytdlp_dateafter }}
{% endif %}
