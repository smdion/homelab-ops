{#- Auto-generated SWAG vhost for the public landing page on www + the bare domain.
    Source: deploy_swag_configs.yaml. Do not edit manually (edit this template instead).

    SWAG serves the static files itself from /config/www/landing (synced from
    files/landing/site/ by the same playbook); there is no upstream container. The bare
    domain used to fall through to the catch-all tarpit in swag_default.conf.j2; it now
    301s to www, and every other unmatched Host still gets the tarpit.

    All add_header lines sit at server level and the asset location uses `expires`
    (not add_header), because an add_header inside a location drops every inherited one. -#}
## Managed by homelab-ops (deploy_swag_configs.yaml) — see templates/swag_landing.conf.j2

server {
    listen 8081 ssl;
    listen 443 ssl;

    server_name {{ vault_domain_ext }};

    include /config/nginx/ssl.conf;
    include /config/nginx/includes/maxmind.conf;

    return 301 https://www.{{ vault_domain_ext }}$request_uri;
}

server {
    listen 8081 ssl;
    listen 443 ssl;

    server_name www.{{ vault_domain_ext }};

    include /config/nginx/ssl.conf;
    include /config/nginx/includes/maxmind.conf;

    root /config/www/landing;
    index index.html;
    charset utf-8;
    server_tokens off;

    add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    # Static page: GET (and HEAD, which GET implies) only.
    location / {
        limit_except GET { deny all; }
        try_files $uri $uri/ =404;
    }

    location ~* \.(?:woff2|jpg|css|js)$ {
        limit_except GET { deny all; }
        expires 7d;
    }

    location ~ /\. {
        deny all;
    }
}
