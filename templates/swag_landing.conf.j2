{#- Auto-generated SWAG vhost for the public landing page on www + the bare domain.
    Source: deploy_swag_configs.yaml. Do not edit manually (edit this template instead).

    SWAG serves the static files itself from /config/www/landing (synced from
    files/landing/site/ by the same playbook); there is no upstream container. The bare
    domain used to fall through to the catch-all tarpit in swag_default.conf.j2; it now
    301s to www, and every other unmatched Host still gets the tarpit.

    Security headers are emitted inside every location on purpose: an add_header in a
    location drops every inherited one, which is the only way to keep SWAG's own
    ssl.conf headers (X-Frame-Options SAMEORIGIN, a looser CSP) from being sent
    alongside these as conflicting duplicates. -#}
{% set _landing_headers = [
  'Content-Security-Policy "default-src \'none\'; img-src \'self\'; style-src \'self\'; font-src \'self\'; script-src \'self\'; base-uri \'none\'; form-action \'none\'; frame-ancestors \'none\'"',
  'Strict-Transport-Security "max-age=31536000"',
  'X-Content-Type-Options "nosniff"',
  'X-Frame-Options "DENY"',
  'Referrer-Policy "no-referrer"',
  'Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"',
  'Cross-Origin-Opener-Policy "same-origin"',
  'Cross-Origin-Resource-Policy "same-origin"',
] %}
{% macro landing_headers() %}
{% for h in _landing_headers %}
        add_header {{ h }} always;
{% endfor %}
{% endmacro %}
## Managed by homelab-ops (deploy_swag_configs.yaml) — see templates/swag_landing.conf.j2

server {
    listen 8081 ssl;
    listen 443 ssl;

    server_name {{ vault_domain_ext }};

    include /config/nginx/ssl.conf;
    include /config/nginx/includes/maxmind.conf;

    return 301 https://www.{{ vault_domain_ext }}$request_uri;
}

server {
    listen 8081 ssl;
    listen 443 ssl;

    server_name www.{{ vault_domain_ext }};

    include /config/nginx/ssl.conf;
    include /config/nginx/includes/maxmind.conf;

    root /config/www/landing;
    index index.html;
    charset utf-8;
    server_tokens off;

    # Static page: GET (and HEAD, which GET implies) only.
    location / {
        limit_except GET { deny all; }
        try_files $uri $uri/ =404;
{{ landing_headers() }}    }

    location ~* \.(?:woff2|jpg|css|js)$ {
        limit_except GET { deny all; }
        expires 7d;
{{ landing_headers() }}    }

    location ~ /\. {
        deny all;
{{ landing_headers() }}    }
}
