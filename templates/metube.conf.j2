# yt-dlp configuration — rendered by Ansible for profile "{{ config_name }}"
# Source: templates/metube.conf.j2 + vars/{{ config_file }}.yaml
# Do not edit on host directly — changes will be overwritten on next run.

# Ignore errors
-i

{% if ytdlp_quiet | default(true) %}
# Quiet logs
-q
{% endif %}

# Quality
-S {{ ytdlp_quality }}

# Paths
-P "{{ ytdlp_download_path }}"
-P "temp:{{ ytdlp_temp_path }}"

# Output template
-o "{{ ytdlp_output }}"

# Channel list and archive
--batch-file="{{ ytdlp_batch_file }}"
--download-archive="{{ ytdlp_archive }}"

# Extractor configuration
--extractor-args "{{ ytdlp_extractor_args }}"

# Cookies — required for YouTube bot-check bypass
{% if ytdlp_cookies | default('') | length > 0 %}
--cookies "{{ ytdlp_cookies }}"
{% endif %}

# Rate limiting — optional. Unset (default) = uncapped; shape/prioritize at the
# firewall instead. Set ytdlp_rate_limit on a profile to deliberately throttle it.
{% if ytdlp_rate_limit | default('') | length > 0 %}
--limit-rate {{ ytdlp_rate_limit }}
{% endif %}

# Retries — absorb transient errors (e.g. Twitch CDN blips), but stay bounded so
# --abort-on-unavailable-fragments can actually fire instead of looping forever.
--retries {{ ytdlp_retries | default(10) }}
--fragment-retries {{ ytdlp_fragment_retries | default(25) }}
{% if ytdlp_abort_on_missing_fragments | default(true) %}
# Abort on a missing fragment so incomplete videos are NOT recorded in the archive
# and get retried next run (instead of yt-dlp skipping fragments and marking success).
--abort-on-unavailable-fragments
{% else %}
--skip-unavailable-fragments
{% endif %}

# HLS downloader. Twitch migrated VOD segments from self-contained MPEG-TS to
# fragmented-MP4 (fMP4) around 2026-08-31; fMP4 needs an #EXT-X-MAP init segment,
# and Twitch's packager lists it AFTER the media segments, which yt-dlp's native
# HLS downloader cannot assemble ("Initialization fragment found after media
# fragments", yt-dlp #10878 — open, no upstream fix). ffmpeg's HLS demuxer reads
# the playlist as a stream, so init-segment position is irrelevant. This is a
# documented, first-class yt-dlp option, not a patch. -nostats/-loglevel warning
# keep ffmpeg's per-fragment chatter out of the Semaphore task log.
{% if ytdlp_hls_downloader | default('ffmpeg') | length > 0 %}
--downloader "m3u8:{{ ytdlp_hls_downloader | default('ffmpeg') }}"
--downloader-args "ffmpeg:-nostats -loglevel warning"
{% endif %}

# Filters
{% if ytdlp_filter_live | default(true) %}
--match-filter !is_live
{% endif %}
--playlist-end {{ ytdlp_playlist_end }}
--reject-title "{{ ytdlp_reject_title }}"
{% if ytdlp_dateafter | default('') | length > 0 %}
--dateafter {{ ytdlp_dateafter }}
{% endif %}

# Video format
--merge-output-format '{{ ytdlp_format }}'

# Post-processing
--embed-thumbnail
--embed-metadata
--add-metadata

# SponsorBlock
--sponsorblock-mark 'all'

# Metadata output for Ansible — one JSON line per downloaded video.
# after_move: prefix ensures only actually-downloaded videos are logged (not skipped/archived).
# %(field)j uses yt-dlp's JSON escape flag for properly quoted strings.
--print-to-file "after_move:{\"id\":%(id)j,\"title\":%(title)j,\"uploader\":%(uploader)j,\"duration\":%(duration_string)j,\"url\":%(original_url)j,\"extractor\":%(extractor_key)j,\"channel_url\":%(channel_url|)j,\"thumbnail\":%(thumbnail)j,\"description\":%(description|)j}" /tmp/downloads_{{ config_name }}.jsonl
