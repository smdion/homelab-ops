# vars/secrets.yaml.example — expected vault keys
# Copy this file to vars/secrets.yaml, fill in your values, then encrypt:
#   cp vars/secrets.yaml.example vars/secrets.yaml
#   ansible-vault encrypt vars/secrets.yaml
#
# To edit later:  ansible-vault edit vars/secrets.yaml
# To view:        ansible-vault view vars/secrets.yaml

# =============================================================================
# DOMAINS
# Used project-wide for URL construction and inventory hostname matching
# =============================================================================
vault_domain_local: "home.local"                      # internal — matches inventory_hostname FQDNs
vault_domain_ext: "example.com"                       # external — used in backup_url, Discord embeds
vault_domain_ext_secondary: "alt.example.com"       # secondary external domain (SWAG, Homepage)

# =============================================================================
# NOTIFICATIONS — Discord
# =============================================================================
# Main webhook — used by all playbook notifications
# Create in Discord: Server Settings → Integrations → Webhooks
vault_discord_webhook_id: ""
vault_discord_webhook_token: ""

# Download channel — per-video notifications from download_videos.yaml
vault_discord_download_webhook_id: ""                # download_videos.yaml per-video webhook
vault_discord_download_webhook_token: ""             # download_videos.yaml per-video webhook

# Apprise — optional alternative/additional notification routing
# Supports 60+ services (Telegram, ntfy, Gotify, Slack, Pushover, etc.)
# CLI mode: requires 'apprise' installed on the Ansible controller (pip install apprise)
# vault_apprise_urls: "tgram://bottoken/chatid ntfy://ntfy.example.com/topic"
# API mode: requires a running Apprise API instance (docker: caronc/apprise-api)
# vault_apprise_api_url: "http://apprise-api:8000"
# vault_apprise_api_key: "ansible"

# =============================================================================
# LOGGING DATABASE (ansible_logging MariaDB)
# Required by every playbook — stores backup/update/maintenance/health records
# =============================================================================
vault_logging_db_host: "10.0.0.1"
vault_logging_db_port: "3306"
vault_logging_db_user: "ansible"
vault_logging_db_password: ""
vault_logging_db_name: "ansible_logging"

# =============================================================================
# SEMAPHORE CONTROLLER
# =============================================================================
vault_semaphore_host_url: "http://10.0.0.1:3001"     # internal URL reachable from controller
vault_semaphore_api_token: ""                         # User menu → API Tokens
vault_semaphore_controller_hostname: "mycontroller"   # short hostname (builds controller_fqdn)

# =============================================================================
# GRAFANA
# =============================================================================
# Create a service account in Grafana (Administration → Service Accounts) with Editor role.
# vault_grafana_url: "http://grafana-host:3000"
# vault_grafana_service_account_token: ""

# =============================================================================
# ANSIBLE USER
# Deployed to all managed hosts by setup_ansible_user.yaml / maintain_pve.yaml
# =============================================================================
# vault_ansible_user_ssh_pubkey: "ssh-ed25519 AAAA..."
# vault_ansible_user_ssh_private_key: |
#   -----BEGIN OPENSSH PRIVATE KEY-----
#   ...
#   -----END OPENSSH PRIVATE KEY-----

# =============================================================================
# DATABASE HOSTS & CREDENTIALS
# =============================================================================
# inventory_hostname values of DB container hosts (used by restore playbooks for delegate_to)
vault_db_host_primary: "dbhost1.home.local"
vault_db_host_secondary: "dbhost2.home.local"

# MariaDB + Postgres root password (shared — used by backup_databases.yaml, restore playbooks)
# vault_db_password: ""

# =============================================================================
# UNIFI APPLIANCES
# =============================================================================
# vault_unvr_api_key: ""                              # Unifi Protect — DEPRECATED: UNVR uses cookie auth, not API key
# vault_unvr_user: ""                                 # Unifi Protect — local admin username (cookie-based login)
# vault_unvr_password: ""                             # Unifi Protect — local admin password
# vault_unifi_network_api_key: ""                     # Network → Settings → Control Plane → Integrations

# =============================================================================
# HOME ASSISTANT
# Only needed for backup_offline.yaml (triggers Synology DSM backup via HA)
# =============================================================================
# vault_ha_url: "http://10.0.0.10:8123"
# vault_ha_bearer_token: ""
# vault_ha_shutdown_button: "button.synology_shutdown"
# vault_ha_dsm_entry_id: ""                                    # HA config entry ID for Synology DSM integration

# =============================================================================
# SYNOLOGY NAS
# Only needed for backup_offline.yaml
# =============================================================================
# vault_synology_ip: "10.0.0.50"
# vault_synology_mac: "AA:BB:CC:DD:EE:FF"
# vault_synology_name: "SYNOLOGY.DOMAIN"

# =============================================================================
# PROXMOX CLUSTER
# =============================================================================
# API token — Datacenter → API Tokens (required by build_ubuntu.yaml, provision_vm.yaml)
# vault_pve_api_host: "pve.home.local"
# vault_pve_api_user: "root@pam"
# vault_pve_api_token_id: "ansible"
# vault_pve_api_token_secret: ""

# Cloud-init default password for provisioned VMs
# vault_pve_vm_password: ""

# VIP / Keepalived (setup_pve_vip.yaml, maintain_pve.yaml)
# vault_pve_vip: "10.0.0.16"
# vault_pve_vrrp_password: ""
# vault_pve_vrrp_priorities:                    # highest priority = MASTER
#   node1: 150
#   node2: 100
#   node3: 50

# Template node — direct IP used for SSH in provision_vm.yaml
# vault_pve_template_node: "node1"

# Node IPs — consumed by pve_definitions.yaml
# vault_pve_nodes:
#   node1: "10.0.0.17"
#   node2: "10.0.0.11"
#   node3: "10.0.0.13"

# Ceph — derived from vault_pve_nodes
# vault_ceph_mons: "{{ vault_pve_nodes.values() | list | join(',') }}"
# vault_ceph_vm_appdata_key: ""

# =============================================================================
# VM PROVISIONING (build_ubuntu.yaml / provision_vm.yaml)
# =============================================================================

# --- Shared network defaults ---
# vault_vm_gateway: "10.0.0.1"
# vault_vm_dns: "10.0.0.1"
# vault_vm_search_domain: "home.local"
# vault_prod_lan_subnet: "{{ vault_vm_gateway | regex_replace('\\.[0-9]+$', '.0/24') }}"

# --- Per-VM secrets (production Docker hosts) ---
# Hostnames are derived: <role>.{{ vault_vm_search_domain }}
# vault_vm_core_hostname: "core.home.local"
# vault_vm_core_ip: "10.0.0.40"                    # VMID 400 — .4x range
# vault_vm_core_node: "node1"
#
# vault_vm_apps_hostname: "apps.home.local"
# vault_vm_apps_ip: "10.0.0.41"                    # VMID 401 — .4x range
# vault_vm_apps_node: "node1"
#
# vault_vm_dev_hostname: "dev.home.local"
# vault_vm_dev_ip: "10.0.0.42"                     # VMID 402 — .4x range
# vault_vm_dev_node: "node1"
#
# vault_vm_amp_hostname: "amp.home.local"
# vault_vm_amp_ip: "10.0.0.70"                     # VMID 700 — .7x range (game servers)
# vault_vm_amp_node: "node2"
# vault_amp_licence_key: "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"  # CubeCoders license UUID

# --- Local hosted desktop VM pool (permanent, offset-based addressing) ---
# VMIDs: vm_hosted_slot_base + offset (VMID 8xx = IP .8x on prod VLAN)
# IPs:   prefix + (offset_base + per-VM offset)
# vault_hosted_vm_ip_prefix: "10.0.0."          # first 3 octets with trailing dot
# vault_hosted_vm_ip_offset: 80                  # last octet of the first hosted VM (.8x range)
# vault_hosted_vm_node: "node1"                  # PVE node; defaults to pve_template_node if empty

# --- TronLabs (public hosted, VLAN 1682, independence local-lvm) ---
# vault_tronlabs_ip: "192.168.12.14"
# vault_tronlabs_node: "independence"

# --- Test VM pool (ephemeral, offset-based addressing) ---
# vault_vm_testvm_hostname: "test-vm.home.local"
# vault_test_vm_ip_prefix: "192.168.13."
# vault_test_vm_ip_offset: 30

# Test VM network isolation (setup_test_network.yaml)
# PREREQUISITE: manually add vault_test_vlan_id to the Proxmox uplink port profile in Unifi UI first.
# See the docs site (network/vlan-design) for exact steps.
# vault_test_vlan_id: 1683
# vault_test_vlan_gateway: "192.168.13.1"
# vault_test_vlan_subnet: "192.168.13.0/24"
# vault_pve_port_profile_name: "Servers-Trunk"

# --- Docker VM VIPs (keepalived — templates/keepalived-docker.conf.j2) ---
# vault_core_vip: "10.0.0.50"                     # .5x range (Docker VIPs)
# vault_apps_vip: "10.0.0.51"
# vault_dev_vip: "10.0.0.52"
# vault_docker_vrrp_password: ""
# vault_docker_vrrp_priorities:                  # short hostname → priority (highest = MASTER)
#   core: 150
#   apps: 150
#   dev: 150

# --- Role mapping (FQDN → role) ---
# vault_vm_roles:
#   core.home.local: core
#   apps.home.local: apps
#   dev.home.local: dev

# =============================================================================
# DOCKER STACK SECRETS
# Referenced by stacks/*/env.j2 templates via deploy_stacks.yaml
# =============================================================================
# Database passwords
# vault_docker_mariadb_password: ""
# vault_docker_postgres_password: ""

# Reverse proxy — trusted CIDRs for Authentik and NPM header forwarding
# vault_docker_trusted_proxy_cidrs: "172.16.0.0/12"

# auth stack — Authentik
# vault_docker_authentik_secret_key: ""

# auth stack — Outbound email (SMTP via Authentik)
# vault_docker_email_username: ""
# vault_docker_email_password: ""
# vault_docker_email: ""

# auth stack — SWAG (Cloudflare DNS validation)
# vault_docker_cloudflare_api_key: ""

# auth stack — CrowdSec bouncer
# vault_docker_crowdsec_api_key: ""

# monitoring stack — CrowdSec Web UI
# vault_docker_crowdsec_web_ui_user: ""
# vault_docker_crowdsec_web_ui_password: ""

# auth stack — MaxMind GeoIP (SWAG mod)
# vault_docker_maxmind_license_key: ""
# vault_docker_maxmind_user_id: ""

# monitoring stack — Grafana OAuth (Authentik provider)
# vault_docker_grafana_admin_password: ""
# vault_docker_grafana_oauth_client_id: ""
# vault_docker_grafana_oauth_client_secret: ""

# infra + vpn stacks — Beszel SSH key
# vault_docker_beszel_key: "ssh-ed25519 AAAA..."

# =============================================================================
# NETWORK INFRASTRUCTURE
# =============================================================================
# VPS — external VPS used for WireGuard endpoint and Unifi network rules
# vault_vps_fqdn: "vps.example.com"
# vault_vps_nfs_ip: "10.0.0.100"               # NFS IP for dev stack (code-server VPS workspace mount; .1xx random range)

# WireGuard internal subnet — used in stacks/vpn/env.j2
# vault_wg_internal_subnet: "10.0.0.0"

# =============================================================================
# BACKBLAZE B2 — Offsite Backups (backup_offsite.yaml)
# =============================================================================
# Create a B2 bucket and application key in the Backblaze web console.
# Capabilities needed: listBuckets, listFiles, readFiles, writeFiles, deleteFiles
# vault_b2_account_id: ""
# vault_b2_application_key: ""
# vault_b2_bucket_name: ""
# vault_restic_repository: "s3:https://s3.us-east-005.backblazeb2.com/your-bucket"
# vault_restic_password: ""
# vault_offsite_host: "backup-host.home.local"

# =============================================================================
# GUACAMOLE — Extra connection secrets (maintain_guacamole.yaml)
# =============================================================================
# vault_red5_ip: ""
# vault_red5_vnc_password: ""

# =============================================================================
# UPTIME KUMA — Dead man's switch (maintain_health.yaml)
# =============================================================================
# Set up a Push monitor in Uptime Kuma, copy the push URL here
# vault_uptime_kuma_push_url: "https://uptime.example.com/api/push/xxxx"

